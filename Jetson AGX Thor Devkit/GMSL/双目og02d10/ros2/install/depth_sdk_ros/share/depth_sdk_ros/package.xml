<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>depth_sdk_ros</name>
  <version>0.1.0</version>
  <description>Thin ROS 2 wrapper over the depth_sdk stereo-depth core library: publishes aligned color + depth images.</description>
  <maintainer email="dev@example.com">depth_sdk</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
